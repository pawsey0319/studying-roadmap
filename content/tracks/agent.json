    },
    {
      "id": "agent.s04",
      "title": "编程 Agent、浏览器与 Computer Use",
      "goal": "理解最赚钱、进展最快的两类 Agent：写代码的 Agent 和操作电脑的 Agent。",
      "items": [
        {
          "id": "agent.s04.i01",
          "kind": "tech",
          "text": "日常使用一款编程 Agent（Claude Code / Codex / Gemini CLI 任选），记录哪些任务能完全交付",
          "mode": "practice"
        },
        {
          "id": "agent.s04.i02",
          "kind": "tech",
          "text": "用 browser-use 做一个自动填表或比价的浏览器 Agent",
          "mode": "practice"
        },
        {
          "id": "agent.s04.i03",
          "kind": "tech",
          "text": "读 OpenGCUA、MAI-Gym 两篇 2026-10 新论文，了解 GUI Agent 如何用 RL 训练",
          "mode": "theory"
        },
        {
          "id": "agent.s04.i04",
          "kind": "prod",
          "text": "做一份“编程 Agent 对产品经理工作的影响”分析：原型、数据分析、文档，哪些环节可以自己完成",
          "mode": "practice"
        },
        {
          "id": "agent.s04.i05",
          "kind": "prod",
          "text": "设计 Computer Use 产品的安全与权限方案：哪些操作必须人工确认",
          "mode": "practice"
        }
      ],
