  "stages": [
    {
      "id": "agent.s01",
      "title": "Agent 基本范式",
      "weeks": [
        1,
        4
      ],
      "goal": "弄懂 Agent = 模型 + 工具 + 循环 + 记忆，能区分“工作流”和“自主智能体”。",
      "items": [
        {
          "id": "agent.s01.i01",
          "kind": "tech",
          "text": "精读 ReAct、Toolformer、Reflexion 三篇论文"
        },
        {
          "id": "agent.s01.i02",
          "kind": "tech",
          "text": "不用框架，用 50 行 Python + 一个模型 API 手写 ReAct 循环（能调搜索、计算器两个工具）"
        },
        {
          "id": "agent.s01.i03",
          "kind": "tech",
          "text": "学完 Hugging Face Agents Course 第 1–2 单元"
        },
        {
          "id": "agent.s01.i04",
          "kind": "prod",
          "text": "精读 Anthropic《Building Effective Agents》，把五种工作流模式（链式、路由、并行、编排者-工作者、评估-优化）各配一个业务例子"
        },
        {
          "id": "agent.s01.i05",
          "kind": "prod",
          "text": "复盘你的 Dumate-Agent 项目：它属于哪种模式？为什么这样选？"
        }
      ],
      "resources": [
        {
          "id": "agent.s01.r01",
