    {
      "id": "agent.s05",
      "title": "评估、可观测与上线",
      "goal": "Agent 的难点在可靠性。学会用基准、轨迹评估和监控把 Agent 推到生产环境。",
      "items": [
        {
          "id": "agent.s05.i01",
          "kind": "tech",
          "text": "了解 SWE-bench、τ-bench、GAIA、OSWorld 四个基准分别测什么",
          "mode": "theory"
        },
        {
          "id": "agent.s05.i02",
          "kind": "tech",
          "text": "用 Langfuse 接入自己的 Agent，记录每一步轨迹、成本、失败点",
          "mode": "practice"
        },
        {
          "id": "agent.s05.i03",
          "kind": "tech",
          "text": "为业务 Agent 建一个 50 条的任务评估集，计算任务成功率与每次成功的成本",
          "mode": "practice"
        },
        {
          "id": "agent.s05.i04",
          "kind": "prod",
          "text": "读 FDE-Gym（2026-10）：Agent 在“需求模糊、约束未说明”的真实交付中表现大幅下降。据此写出 Agent 产品的“需求澄清”设计",
          "mode": "theory"
        },
        {
          "id": "agent.s05.i05",
          "kind": "prod",
          "text": "写一份 Agent 上线 checklist：权限、兜底、人工接管、计费、监控指标",
          "mode": "practice"
        },
        {
          "id": "agent.s05.i06",
          "kind": "prod",
          "text": "把整个板块成果整理成作品集，对外讲一个完整的 Agent 产品故事",
          "mode": "practice"
        }
      ],
