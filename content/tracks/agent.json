          "url": "https://github.com/anthropics/skills"
        },
        {
          "id": "agent.s02.r07",
          "name": "AGENTS.md 规范",
          "url": "https://agents.md/"
        },
        {
          "id": "agent.s02.r08",
          "name": "2026 Agent 协议栈综述",
          "url": "https://dev.to/alexmercedcoder/the-state-of-agentic-ai-standards-in-2026-mcp-a2a-webmcp-osi-and-the-protocol-stack-taking-3o2l"
        },
        {
          "id": "agent.s02.r09",
          "name": "MCP vs A2A（2026）",
          "url": "https://beam.ai/agentic-insights/agent2agent-vs-mcp-2026-ai-agent-stack"
        },
        {
          "id": "agent.s02.r10",
          "name": "The Verge: 网站开始屏蔽 AI Agent（2026-10）",
          "url": "https://www.theverge.com/ai-artificial-intelligence/1013195/ai-agents-blocked-web"
        }
      ],
      "output": "自写 MCP Server + 一个 Skill + 协议栈图"
    },
    {
      "id": "agent.s03",
      "title": "框架与多智能体",
      "goal": "会用至少一个主流框架搭有状态的 Agent，知道多智能体什么时候值得用、什么时候是过度设计。",
      "items": [
        {
          "id": "agent.s03.i01",
          "kind": "tech",
          "text": "用 LangGraph 实现一个带状态、可中断、可人工审批的业务 Agent",
          "mode": "practice"
        },
        {
          "id": "agent.s03.i02",
          "kind": "tech",
          "text": "对比 OpenAI Agents SDK、Claude Agent SDK、smolagents、PydanticAI 的设计取舍（各跑通一个 Demo）",
          "mode": "practice"
        },
        {
          "id": "agent.s03.i03",
          "kind": "tech",
          "text": "用 mem0 给 Agent 加长期记忆，观察记忆写入的错误类型",
          "mode": "practice"
        },
        {
          "id": "agent.s03.i04",
          "kind": "prod",
          "text": "读《12-Factor Agents》，对照检查你的 Agent 是否符合生产原则",
          "mode": "theory"
        },
        {
          "id": "agent.s03.i05",
          "kind": "prod",
          "text": "用 Dify 或扣子（Coze）10 分钟搭一个零代码 Agent，对比代码方案的效率与上限，总结低代码平台的适用边界",
          "mode": "practice"
        }
      ],
