{
  "id": "agent",
  "domain": "ai",
  "name": "智能体",
  "short": "智能体",
  "color": "#E0662B",
  "goal": "能设计、搭建、评估一个生产可用的 Agent，并理解协议生态（MCP / A2A / Skills）与商业模式。",
  "live": {
    "hf": "LLM agent tool use benchmark",
    "hn": "AI agent",
    "gh": "ai-agent"
  },
  "stages": [
    {
      "id": "agent.s01",
      "title": "Agent 基本范式",
      "goal": "弄懂 Agent = 模型 + 工具 + 循环 + 记忆，能区分“工作流”和“自主智能体”。",
      "items": [
        {
          "id": "agent.s01.i01",
          "kind": "tech",
          "text": "精读 ReAct、Toolformer、Reflexion 三篇论文",
          "mode": "theory"
        },
        {
          "id": "agent.s01.i02",
          "kind": "tech",
          "text": "不用框架，用 50 行 Python + 一个模型 API 手写 ReAct 循环（能调搜索、计算器两个工具）",
          "mode": "practice"
        },
        {
          "id": "agent.s01.i03",
          "kind": "tech",
          "text": "学完 Hugging Face Agents Course 第 1–2 单元",
          "mode": "theory"
        },
        {
          "id": "agent.s01.i04",
          "kind": "prod",
          "text": "精读 Anthropic《Building Effective Agents》，把五种工作流模式（链式、路由、并行、编排者-工作者、评估-优化）各配一个业务例子",
          "mode": "theory"
        },
        {
          "id": "agent.s01.i05",
          "kind": "prod",
          "text": "复盘你的 Dumate-Agent 项目：它属于哪种模式？为什么这样选？",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "agent.s01.r01",
          "name": "ReAct 论文",
          "url": "https://arxiv.org/abs/2210.03629"
        },
        {
          "id": "agent.s01.r02",
          "name": "Toolformer 论文",
          "url": "https://arxiv.org/abs/2302.04761"
        },
        {
          "id": "agent.s01.r03",
          "name": "Reflexion 论文",
          "url": "https://arxiv.org/abs/2303.11366"
        },
        {
          "id": "agent.s01.r04",
          "name": "Generative Agents（斯坦福小镇）",
          "url": "https://arxiv.org/abs/2304.03442"
        },
        {
          "id": "agent.s01.r05",
          "name": "Anthropic: Building Effective Agents",
          "url": "https://www.anthropic.com/engineering/building-effective-agents"
        },
        {
          "id": "agent.s01.r06",
          "name": "Lilian Weng: LLM Powered Autonomous Agents",
          "url": "https://lilianweng.github.io/posts/2023-06-23-agent/"
        },
        {
          "id": "agent.s01.r07",
          "name": "Hugging Face Agents Course",
          "url": "https://huggingface.co/learn/agents-course"
        },
        {
          "id": "agent.s01.r08",
          "name": "Datawhale hello-agents（中文）",
          "url": "https://github.com/datawhalechina/hello-agents"
        },
        {
          "id": "agent.s01.r09",
          "name": "Microsoft AI Agents for Beginners",
          "url": "https://github.com/microsoft/ai-agents-for-beginners"
        }
      ],
      "output": "手写 ReAct 脚本 + 五种模式业务对照表"
    },
    {
      "id": "agent.s02",
      "title": "工具、上下文与协议：MCP / A2A / Skills",
      "goal": "掌握让 Agent 接入真实世界的三件事：写好工具、管好上下文、用标准协议连接。",
      "items": [
        {
          "id": "agent.s02.i01",
          "kind": "tech",
          "text": "读 MCP 官方文档，写一个自己的 MCP Server（如读取本地笔记或查询行情）",
          "mode": "practice"
        },
        {
          "id": "agent.s02.i02",
          "kind": "tech",
          "text": "读 A2A 协议，理解 Agent 与 Agent 之间如何发现、委派、回传结果",
          "mode": "theory"
        },
        {
          "id": "agent.s02.i03",
          "kind": "tech",
          "text": "读 Anthropic 关于工具设计、上下文工程、Agent Skills 的三篇工程文章，并给自己的 Agent 写一个 Skill",
          "mode": "practice"
        },
        {
          "id": "agent.s02.i04",
          "kind": "prod",
          "text": "画 2026 年 Agent 协议栈图：MCP（连工具）、A2A（连 Agent）、AG-UI（连界面）、支付协议",
          "mode": "practice"
        },
        {
          "id": "agent.s02.i05",
          "kind": "prod",
          "text": "分析“网站开始屏蔽 AI Agent”这件事对 Agent 产品的影响，以及可能的商业对策",
          "mode": "theory"
        }
      ],
      "resources": [
        {
          "id": "agent.s02.r01",
          "name": "Model Context Protocol",
          "url": "https://modelcontextprotocol.io/"
        },
        {
          "id": "agent.s02.r02",
          "name": "A2A Protocol",
          "url": "https://a2a-protocol.org/"
        },
        {
