{
  "id": "slm",
  "domain": "ai",
  "name": "单领域小模型",
  "short": "小模型",
  "color": "#13836B",
  "hours": 2,
  "goal": "掌握“选底座 → 造数据 → 微调/蒸馏 → 评估 → 端侧部署”的完整闭环，能判断一个场景该用小模型还是大模型 API。",
  "live": {
    "hf": "small language model fine-tuning domain",
    "hn": "small language model",
    "gh": "fine-tuning"
  },
  "stages": [
    {
      "id": "slm.s01",
      "title": "小模型地图与本地运行",
      "weeks": [
        1,
        4
      ],
      "goal": "知道 2026 年主流小模型有哪些、各自强项，并能在自己电脑上跑起来。",
      "items": [
        {
          "id": "slm.s01.i01",
          "kind": "tech",
          "text": "用 Ollama 或 llama.cpp 本地跑 Qwen、Gemma、MiniCPM 的小尺寸版本（1–9B）"
        },
        {
          "id": "slm.s01.i02",
          "kind": "tech",
          "text": "了解 GGUF 格式与 4-bit/8-bit 量化对显存和质量的影响（Mac 用户可试 MLX）"
        },
        {
          "id": "slm.s01.i03",
          "kind": "tech",
          "text": "读小模型综述，整理“参数量 / 能力 / 上下文 / 许可证”对照表"
        },
        {
          "id": "slm.s01.i04",
          "kind": "prod",
          "text": "读《Small Language Models are the Future of Agentic AI》，总结小模型的三条产品理由：成本、延迟、隐私"
        },
        {
          "id": "slm.s01.i05",
          "kind": "prod",
          "text": "列 5 个你认为“小模型比大模型 API 更合适”的场景，并写出判断依据"
        }
      ],
      "resources": [
        {
          "id": "slm.s01.r01",
          "name": "Ollama",
          "url": "https://ollama.com/"
        },
        {
          "id": "slm.s01.r02",
          "name": "llama.cpp",
          "url": "https://github.com/ggml-org/llama.cpp"
        },
        {
          "id": "slm.s01.r03",
          "name": "MLX / mlx-lm（Apple 芯片）",
          "url": "https://github.com/ml-explore/mlx-lm"
        },
        {
          "id": "slm.s01.r04",
          "name": "SLM 综述（2026 更新版）",
          "url": "https://arxiv.org/abs/2501.05465"
        },
        {
          "id": "slm.s01.r05",
          "name": "Small Language Models are the Future of Agentic AI",
          "url": "https://arxiv.org/abs/2506.02153"
        },
        {
          "id": "slm.s01.r06",
          "name": "Qwen3",
          "url": "https://github.com/QwenLM/Qwen3"
        },
        {
          "id": "slm.s01.r07",
          "name": "MiniCPM（面壁，端侧）",
          "url": "https://github.com/OpenBMB/MiniCPM"
        },
        {
          "id": "slm.s01.r08",
          "name": "SmolLM3 博客",
          "url": "https://huggingface.co/blog/smollm3"
        },
        {
          "id": "slm.s01.r09",
          "name": "2026-10 本地模型推荐",
          "url": "https://techpilot.ai/best-local-ai-models/"
        }
      ],
      "output": "本地模型对照表 + 场景判断清单"
    },
    {
      "id": "slm.s02",
      "title": "从零训一个迷你模型",
      "weeks": [
        5,
        8
      ],
      "goal": "用很小的算力完整走一遍预训练与 SFT，弄清每个环节花多少钱、多少时间。",
      "items": [
        {
          "id": "slm.s02.i01",
          "kind": "tech",
          "text": "跟 MiniMind 用单卡（或云 GPU 几小时）训练一个 ~26M 参数的中文小模型"
        },
        {
          "id": "slm.s02.i02",
          "kind": "tech",
          "text": "读《Textbooks Are All You Need》，理解“数据质量 > 数据规模”对小模型为什么更重要"
        },
        {
          "id": "slm.s02.i03",
          "kind": "tech",
          "text": "跟 HF smol-course 学习 SFT 与对齐的基本流程"
        },
        {
          "id": "slm.s02.i04",
          "kind": "prod",
          "text": "记录训练全过程的算力、时长、费用，形成“小模型训练成本卡片”"
        }
      ],
      "resources": [
        {
          "id": "slm.s02.r01",
          "name": "MiniMind（从零训练小模型，中文）",
          "url": "https://github.com/jingyaogong/minimind"
        },
        {
          "id": "slm.s02.r02",
          "name": "Datawhale tiny-universe（手搓小模型）",
          "url": "https://github.com/datawhalechina/tiny-universe"
        },
        {
          "id": "slm.s02.r03",
          "name": "Textbooks Are All You Need（phi-1）",
          "url": "https://arxiv.org/abs/2306.11644"
        },
        {
          "id": "slm.s02.r04",
          "name": "HF smol-course",
          "url": "https://github.com/huggingface/smol-course"
        },
        {
          "id": "slm.s02.r05",
          "name": "HF LLM Course（中文可选）",
          "url": "https://huggingface.co/learn/llm-course"
        }
      ],
      "output": "自己训练的迷你模型 + 成本卡片"
    },
    {
      "id": "slm.s03",
      "title": "领域数据与微调：LoRA / QLoRA",
      "weeks": [
        9,
        15
      ],
      "goal": "为一个具体领域（建议选金融研报问答，可与量化板块共用）造数据并微调出可用模型。",
      "items": [
        {
          "id": "slm.s03.i01",
          "kind": "tech",
          "text": "精读 LoRA、QLoRA 论文，理解低秩适配为什么省显存"
        },
        {
          "id": "slm.s03.i02",
          "kind": "tech",
          "text": "用 Easy Dataset 或 distilabel，从领域文档合成 1000 条指令数据，并人工抽检 100 条"
        },
        {
          "id": "slm.s03.i03",
          "kind": "tech",
          "text": "用 LLaMA-Factory 或 Unsloth 对 Qwen 小模型做 LoRA 微调"
        },
        {
          "id": "slm.s03.i04",
          "kind": "tech",
          "text": "用 lm-evaluation-harness 或自建评估集对比：底座 vs 微调后 vs 大模型 API"
        },
        {
          "id": "slm.s03.i05",
          "kind": "prod",
          "text": "写一份“数据卡片”：来源、授权、清洗规则、隐私处理（领域数据的合规是落地第一关）"
        },
        {
          "id": "slm.s03.i06",
          "kind": "prod",
          "text": "算 ROI：微调一次的成本、推理节省、效果差距，判断这个场景值不值得微调"
        }
      ],
      "resources": [
        {
          "id": "slm.s03.r01",
          "name": "LoRA 论文",
          "url": "https://arxiv.org/abs/2106.09685"
        },
        {
          "id": "slm.s03.r02",
          "name": "QLoRA 论文",
          "url": "https://arxiv.org/abs/2305.14314"
        },
        {
          "id": "slm.s03.r03",
          "name": "LLaMA-Factory",
          "url": "https://github.com/hiyouga/LLaMA-Factory"
        },
        {
          "id": "slm.s03.r04",
          "name": "Unsloth 文档",
          "url": "https://docs.unsloth.ai/"
        },
        {
          "id": "slm.s03.r05",
          "name": "PEFT",
          "url": "https://github.com/huggingface/peft"
        },
        {
          "id": "slm.s03.r06",
          "name": "TRL",
          "url": "https://github.com/huggingface/trl"
        },
        {
          "id": "slm.s03.r07",
          "name": "Easy Dataset（领域数据集构建）",
          "url": "https://github.com/ConardLi/easy-dataset"
        },
        {
          "id": "slm.s03.r08",
          "name": "distilabel（合成数据）",
          "url": "https://github.com/argilla-io/distilabel"
        },
        {
          "id": "slm.s03.r09",
          "name": "lm-evaluation-harness",
          "url": "https://github.com/EleutherAI/lm-evaluation-harness"
        },
        {
          "id": "slm.s03.r10",
          "name": "FinGPT（金融领域参考）",
          "url": "https://github.com/AI4Finance-Foundation/FinGPT"
        },
        {
          "id": "slm.s03.r11",
          "name": "BloombergGPT 论文",
          "url": "https://arxiv.org/abs/2303.17564"
        },
        {
          "id": "slm.s03.r12",
          "name": "MedicalGPT（医疗领域训练流程参考）",
          "url": "https://github.com/shibing624/MedicalGPT"
        }
      ],
      "output": "领域微调模型 + 三方对比评估报告 + 数据卡片"
    },
    {
      "id": "slm.s04",
      "title": "蒸馏、Embedding 与专用小模型",
      "weeks": [
        16,
        21
      ],
      "goal": "小模型不只是“聊天模型”：学会蒸馏，学会用 Embedding / Reranker / 时间序列等专用模型解决问题。",
      "items": [
        {
          "id": "slm.s04.i01",
          "kind": "tech",
          "text": "读 Hinton 知识蒸馏论文，用大模型输出作为教师数据蒸馏你的领域小模型"
        },
        {
          "id": "slm.s04.i02",
          "kind": "tech",
          "text": "用 BGE 系列 Embedding + Reranker 给 RAG 换上自部署检索模型，对比效果"
        },
        {
          "id": "slm.s04.i03",
          "kind": "tech",
          "text": "了解金融 K 线基础模型 Kronos 等时间序列模型（与量化板块衔接）"
        },
        {
          "id": "slm.s04.i04",
          "kind": "prod",
          "text": "画出“大模型 + 小模型”协作架构：哪些步骤交给小模型（分类、抽取、路由），哪些交给大模型"
        },
        {
          "id": "slm.s04.i05",
          "kind": "prod",
          "text": "查 MTEB 榜单，为中文场景选 Embedding 模型并写理由"
        }
      ],
      "resources": [
        {
          "id": "slm.s04.r01",
          "name": "Distilling the Knowledge in a Neural Network",
          "url": "https://arxiv.org/abs/1503.02531"
        },
        {
          "id": "slm.s04.r02",
          "name": "FlagEmbedding（BGE）",
          "url": "https://github.com/FlagOpen/FlagEmbedding"
        },
        {
          "id": "slm.s04.r03",
          "name": "MTEB 榜单",
          "url": "https://huggingface.co/spaces/mteb/leaderboard"
        },
        {
          "id": "slm.s04.r04",
          "name": "Sentence Transformers",
          "url": "https://sbert.net/"
        },
        {
          "id": "slm.s04.r05",
          "name": "Kronos（金融 K 线基础模型）",
          "url": "https://github.com/shiyu-coder/Kronos"
        }
      ],
      "output": "蒸馏实验记录 + 大小模型协作架构图"
    },
    {
      "id": "slm.s05",
      "title": "端侧部署与产品化",
      "weeks": [
        22,
        26
      ],
      "goal": "把领域小模型部署到真实设备或私有服务器上，形成一个可演示的小产品。",
      "items": [
        {
          "id": "slm.s05.i01",
          "kind": "tech",
          "text": "把微调模型量化成 GGUF，用 llama.cpp / Ollama 发布为本地服务"
        },
        {
          "id": "slm.s05.i02",
          "kind": "tech",
          "text": "用 vLLM 部署成 OpenAI 兼容接口，测吞吐与并发"
        },
        {
          "id": "slm.s05.i03",
          "kind": "prod",
          "text": "写一个“私有化部署方案”：硬件配置、报价、运维、数据不出域的卖点"
        },
        {
          "id": "slm.s05.i04",
          "kind": "prod",
          "text": "做 5 分钟 Demo 视频，讲清楚场景、效果、成本"
        }
      ],
      "resources": [
        {
          "id": "slm.s05.r01",
          "name": "llama.cpp",
          "url": "https://github.com/ggml-org/llama.cpp"
        },
        {
          "id": "slm.s05.r02",
          "name": "vLLM",
          "url": "https://github.com/vllm-project/vllm"
        },
        {
          "id": "slm.s05.r03",
          "name": "小模型做端侧 Agent（2026 指南）",
          "url": "https://www.digitalapplied.com/blog/small-language-models-on-device-agents-2026-guide"
        }
      ],
      "output": "可演示的私有化领域小模型 + 部署方案"
    }
  ],
  "frontier": [
    {
      "id": "slm.f01",
      "title": "小模型做 Agent 的主力",
      "desc": "3–9B 模型已能完成大部分工具调用和格式化步骤，大模型只在关键决策时介入（大小模型路由）。",
      "links": [
        {
          "name": "SLM 做端侧 Agent",
          "url": "https://www.digitalapplied.com/blog/small-language-models-on-device-agents-2026-guide"
