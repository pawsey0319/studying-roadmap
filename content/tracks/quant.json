{
  "id": "quant",
  "domain": "ai",
  "name": "量化",
  "short": "量化",
  "color": "#7B3FC0",
  "goal": "从零开始，做到能用 Python 获取数据、回测策略、小资金合规实盘，并能用大模型和智能体辅助投研。重点是个人量化：小资金、免费数据、本地回测、券商接口。",
  "note": "风险提示：本板块只用于学习，不构成投资建议。回测收益不代表实盘收益，个人量化先跑模拟盘，再用亏得起的小资金试。监管规则以证监会和交易所官网原文为准。",
  "live": {
    "hf": "quantitative trading LLM",
    "hn": "algorithmic trading",
    "gh": "quantitative-trading"
  },
  "stages": [
    {
      "id": "quant.s01",
      "title": "金融市场与指标常识",
      "goal": "零基础补齐“交易什么、怎么交易、怎么衡量好坏”。",
      "items": [
        {
          "id": "quant.s01.i01",
          "kind": "tech",
          "text": "搞懂 A 股规则：T+1、涨跌停、集合竞价、佣金与印花税、复权（前复权/后复权）",
          "mode": "theory"
        },
        {
          "id": "quant.s01.i02",
          "kind": "tech",
          "text": "用概率论知识理解收益率、波动率、相关性，手算一遍夏普比率与最大回撤",
          "mode": "theory"
        },
        {
          "id": "quant.s01.i03",
          "kind": "tech",
          "text": "学 Datawhale whale-quant 前几章，建立量化交易的整体框架",
          "mode": "theory"
        },
        {
          "id": "quant.s01.i04",
          "kind": "prod",
          "text": "画出个人量化的“用户旅程”：学习 → 选平台 → 拿数据 → 回测 → 模拟 → 实盘，标出每一步的痛点",
          "mode": "practice"
        },
        {
          "id": "quant.s01.i05",
          "kind": "prod",
          "text": "对比 聚宽 / 米筐 / BigQuant / 果仁 等平台：面向谁、怎么收费、门槛在哪",
          "mode": "theory"
        }
      ],
      "resources": [
        {
          "id": "quant.s01.r01",
          "name": "Datawhale whale-quant（量化入门，中文）",
          "url": "https://github.com/datawhalechina/whale-quant"
        },
        {
          "id": "quant.s01.r02",
          "name": "上海证券交易所（交易规则与投教）",
          "url": "https://www.sse.com.cn/"
        },
        {
          "id": "quant.s01.r03",
          "name": "深圳证券交易所（交易规则与投教）",
          "url": "https://www.szse.cn/"
        },
        {
          "id": "quant.s01.r04",
          "name": "2026-07-06 起沪深北交易新规讨论",
          "url": "https://linux.do/t/topic/2508684"
        },
        {
          "id": "quant.s01.r05",
          "name": "Investopedia（英文金融词典，浏览器打开）",
          "url": "https://www.investopedia.com/"
        },
        {
          "id": "quant.s01.r06",
          "name": "《聪明的投资者》（本杰明·格雷厄姆）"
        },
        {
          "id": "quant.s01.r07",
          "name": "《打开量化投资的黑箱》（里什·纳兰）"
        },
        {
          "id": "quant.s01.r08",
          "name": "聚宽 JoinQuant",
          "url": "https://www.joinquant.com/"
        },
        {
          "id": "quant.s01.r09",
          "name": "米筐 RiceQuant",
          "url": "https://www.ricequant.com/"
        },
        {
          "id": "quant.s01.r10",
          "name": "BigQuant",
          "url": "https://bigquant.com/"
        },
        {
          "id": "quant.s01.r11",
          "name": "果仁网",
          "url": "https://guorn.com/"
        }
      ],
      "output": "个人量化名词表 + 平台对比表"
    },
    {
      "id": "quant.s02",
      "title": "Python 数据分析与行情数据",
      "goal": "把基础 Python 升级到 pandas 数据分析，能稳定拿到免费行情数据。",
      "items": [
        {
          "id": "quant.s02.i01",
          "kind": "tech",
          "text": "读《Python for Data Analysis》的 pandas 与时间序列章节",
          "mode": "theory"
        },
        {
          "id": "quant.s02.i02",
          "kind": "tech",
          "text": "用 AKShare / BaoStock 拉取沪深 300 成分股日线，存成本地 Parquet 或 SQLite",
          "mode": "practice"
        },
        {
          "id": "quant.s02.i03",
          "kind": "tech",
          "text": "计算并画出均线、MACD、RSI、布林带，理解每个指标在描述什么",
          "mode": "practice"
        },
        {
          "id": "quant.s02.i04",
          "kind": "prod",
          "text": "评估免费数据源：覆盖范围、更新时间、稳定性、是否允许商用，写一页数据源选型说明",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "quant.s02.r01",
          "name": "Python for Data Analysis（免费在线版）",
          "url": "https://wesmckinney.com/book/"
        },
        {
          "id": "quant.s02.r02",
          "name": "AKShare 文档",
          "url": "https://akshare.akfamily.xyz/"
        },
        {
          "id": "quant.s02.r03",
          "name": "AKShare GitHub",
          "url": "https://github.com/akfamily/akshare"
        },
        {
          "id": "quant.s02.r04",
          "name": "BaoStock",
          "url": "http://baostock.com/"
        },
        {
          "id": "quant.s02.r05",
          "name": "Tushare Pro",
          "url": "https://tushare.pro/"
        },
        {
          "id": "quant.s02.r06",
          "name": "yfinance（美股/港股数据）",
          "url": "https://github.com/ranaroussi/yfinance"
        },
        {
          "id": "quant.s02.r07",
          "name": "Kaggle Python 微课程",
          "url": "https://www.kaggle.com/learn/python"
        }
      ],
      "output": "本地行情数据库 + 指标可视化笔记本"
    },
    {
      "id": "quant.s03",
      "title": "回测与第一个策略",
      "goal": "写出并正确回测第一个策略，学会识别“看起来赚钱其实是假的”回测。",
      "items": [
        {
          "id": "quant.s03.i01",
          "kind": "tech",
          "text": "用 backtesting.py 或 Backtrader 实现双均线策略，再用 vectorbt 做参数扫描",
          "mode": "practice"
        },
        {
          "id": "quant.s03.i02",
          "kind": "tech",
          "text": "实现一个 ETF 动量轮动策略（个人量化最常见、门槛最低的策略类型）",
          "mode": "practice"
        },
        {
          "id": "quant.s03.i03",
          "kind": "tech",
          "text": "专门检查四个坑：未来函数、幸存者偏差、交易成本与滑点、过拟合（样本内外切分）",
          "mode": "theory"
        },
        {
          "id": "quant.s03.i04",
          "kind": "prod",
          "text": "设计一份标准回测报告模板：年化收益、波动率、夏普、最大回撤、换手、与基准对比",
          "mode": "practice"
        },
        {
          "id": "quant.s03.i05",
          "kind": "prod",
          "text": "写一篇《为什么 90% 的回测曲线不可信》短文",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "quant.s03.r01",
          "name": "backtesting.py",
          "url": "https://github.com/kernc/backtesting.py"
        },
        {
          "id": "quant.s03.r02",
          "name": "Backtrader",
          "url": "https://www.backtrader.com/"
        },
        {
          "id": "quant.s03.r03",
          "name": "vectorbt",
          "url": "https://github.com/polakowo/vectorbt"
        },
        {
          "id": "quant.s03.r04",
          "name": "QuantConnect（含教程与 LEAN 引擎）",
          "url": "https://www.quantconnect.com/"
        },
        {
          "id": "quant.s03.r05",
          "name": "Quantopian 研究笔记本合集",
          "url": "https://github.com/quantopian/research_public"
        },
        {
          "id": "quant.s03.r06",
          "name": "《量化交易：如何建立自己的算法交易事业》（Ernest Chan）"
        },
        {
          "id": "quant.s03.r07",
          "name": "The Probability of Backtest Overfitting（SSRN，浏览器打开）",
          "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2326253"
        }
      ],
      "output": "两个策略的回测报告 + 回测避坑清单"
    },
    {
      "id": "quant.s04",
      "title": "多因子与机器学习选股",
      "goal": "理解机构主流的多因子框架，用机器学习做截面选股。",
      "items": [
        {
          "id": "quant.s04.i01",
          "kind": "tech",
          "text": "学因子三件套：IC/IR、分层回测、因子中性化；用 Fama-French 数据理解经典因子",
          "mode": "theory"
        },
        {
          "id": "quant.s04.i02",
          "kind": "tech",
          "text": "读《101 Formulaic Alphas》，挑 5 个因子在 A 股上复现",
          "mode": "practice"
        },
        {
          "id": "quant.s04.i03",
          "kind": "tech",
          "text": "跑通微软 Qlib 的 LightGBM 基线（Alpha158 因子 + 沪深 300）",
          "mode": "practice"
        },
        {
          "id": "quant.s04.i04",
          "kind": "tech",
          "text": "读《An Introduction to Statistical Learning》的回归、树模型章节补统计学习基础",
          "mode": "theory"
        },
        {
          "id": "quant.s04.i05",
          "kind": "prod",
          "text": "思考：因子在公开后会衰减，个人投资者的优势和劣势各在哪里（资金小、灵活 vs 数据和算力弱）",
          "mode": "theory"
        }
      ],
      "resources": [
        {
          "id": "quant.s04.r01",
          "name": "101 Formulaic Alphas",
          "url": "https://arxiv.org/abs/1601.00991"
        },
        {
          "id": "quant.s04.r02",
          "name": "Fama-French 数据库",
          "url": "https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/data_library.html"
        },
        {
          "id": "quant.s04.r03",
          "name": "Microsoft Qlib",
          "url": "https://github.com/microsoft/qlib"
        },
        {
