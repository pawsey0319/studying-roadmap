        },
        {
          "id": "quant.s04.r08",
          "name": "《Advances in Financial Machine Learning》（López de Prado）"
        },
        {
          "id": "quant.s04.r09",
          "name": "awesome-quant（中文资源合集）",
          "url": "https://github.com/thuquant/awesome-quant"
        },
        {
          "id": "quant.s04.r10",
          "name": "awesome-quant（英文资源合集）",
          "url": "https://github.com/wilsonfreitas/awesome-quant"
        }
      ],
      "output": "5 个复现因子的检验报告 + Qlib 基线结果"
    },
    {
      "id": "quant.s05",
      "title": "个人实盘：券商接口与合规",
      "goal": "用合规的方式把策略接上真实账户，从模拟盘到小资金实盘。",
      "items": [
        {
          "id": "quant.s05.i01",
          "kind": "tech",
          "text": "了解个人量化的三条路：券商 QMT / miniQMT、PTrade、vn.py；弄清开通门槛（各券商对资产要求不同，需逐一咨询）",
          "mode": "theory"
        },
        {
          "id": "quant.s05.i02",
          "kind": "tech",
          "text": "在 QMT 模拟盘跑通“行情订阅 → 信号 → 下单 → 成交回报 → 日志”全流程",
          "mode": "practice"
        },
        {
          "id": "quant.s05.i03",
          "kind": "tech",
          "text": "写风控模块：单票仓位上限、单日亏损熔断、断线重连、异常下单拦截",
          "mode": "practice"
        },
        {
          "id": "quant.s05.i04",
          "kind": "prod",
          "text": "学习程序化交易监管：2025 年 7 月 7 日起施行的沪深北《程序化交易管理实施细则》要求程序化交易先报告，并对高频交易（如单账户每秒申报撤单达 300 笔以上或单日达 2 万笔以上）有额外要求。个人低频策略也要先向券商报告",
          "mode": "theory"
        },
        {
          "id": "quant.s05.i05",
          "kind": "prod",
          "text": "设计一个“个人量化工具”的产品方案：目标用户、核心功能、合规边界、收费方式",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "quant.s05.r01",
          "name": "迅投 QMT / xtquant 文档",
          "url": "https://dict.thinktrader.net/"
        },
        {
          "id": "quant.s05.r02",
          "name": "vn.py",
          "url": "https://github.com/vnpy/vnpy"
        },
        {
          "id": "quant.s05.r03",
          "name": "PTrade 从零到实盘",
          "url": "https://cloud.tencent.com/developer/article/2752236"
        },
        {
          "id": "quant.s05.r04",
          "name": "QMT 与 PTrade 区别",
          "url": "https://www.cnblogs.com/bigleft/p/18286458"
        },
        {
          "id": "quant.s05.r05",
          "name": "miniQMT + Backtrader 实践",
          "url": "https://juejin.cn/post/7518950408272068648"
        },
        {
          "id": "quant.s05.r06",
          "name": "中国证监会（规章原文）",
          "url": "https://www.csrc.gov.cn/"
        },
        {
          "id": "quant.s05.r07",
          "name": "上交所《程序化交易管理实施细则》（在上交所官网“规则”栏目搜索）"
        },
        {
          "id": "quant.s05.r08",
          "name": "个人 QMT 策略实盘经验帖（2026）",
          "url": "https://linux.do/t/topic/2525120"
        }
      ],
      "output": "模拟盘稳定运行 4 周的日志 + 风控模块 + 合规笔记"
    },
    {
      "id": "quant.s06",
      "title": "AI + 量化：大模型与智能体投研",
      "goal": "把前三个板块学到的东西用到量化上，这是你的差异化方向。",
      "items": [
        {
          "id": "quant.s06.i01",
          "kind": "tech",
          "text": "跑通 TradingAgents（多智能体：分析师、研究员、交易员、风控），换成国产模型对比决策质量",
          "mode": "practice"
        },
        {
          "id": "quant.s06.i02",
          "kind": "tech",
          "text": "跑通 RD-Agent(Q)：用 Agent 自动挖因子、调模型",
          "mode": "practice"
        },
        {
          "id": "quant.s06.i03",
          "kind": "tech",
          "text": "用大模型做研报/公告情绪因子，接入 Qlib 检验 IC",
          "mode": "practice"
        },
        {
          "id": "quant.s06.i04",
          "kind": "tech",
          "text": "试用 Kronos 做 K 线预测，和传统模型对比",
          "mode": "practice"
        },
        {
          "id": "quant.s06.i05",
          "kind": "prod",
          "text": "批判性评估：LLM 选股回测常有数据泄漏（模型训练时已见过未来新闻），写出你的检验方法",
          "mode": "theory"
        },
        {
          "id": "quant.s06.i06",
          "kind": "prod",
          "text": "设计一个“AI 投研助手”产品：给个人投资者的是信息整理与纪律提醒，而不是荐股（合规红线）",
          "mode": "practice"
        }
      ],
      "resources": [
