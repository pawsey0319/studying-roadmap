{
  "id": "llm",
  "domain": "ai",
  "name": "AI 大模型",
  "short": "大模型",
  "color": "#2F5BD3",
  "hours": 3,
  "goal": "从“会用、懂 Transformer”走到能看懂训练/后训练/推理部署的关键取舍，并能把前沿进展翻译成产品判断。",
  "live": {
    "hf": "large language model reasoning",
    "hn": "LLM",
    "gh": "llm"
  },
  "stages": [
    {
      "id": "llm.s01",
      "title": "从 Transformer 到 GPT：亲手搭一遍",
      "weeks": [
        1,
        4
      ],
      "goal": "把已知的 Transformer 架构变成能跑的代码，同时建立对 token、上下文、价格的产品直觉。",
      "items": [
        {
          "id": "llm.s01.i01",
          "kind": "tech",
          "text": "看完 Karpathy《Let's build GPT》并逐行复现，跑通 nanoGPT 的 Shakespeare 字符级模型"
        },
        {
          "id": "llm.s01.i02",
          "kind": "tech",
          "text": "看《Let's build the GPT Tokenizer》，手写一个最小 BPE 分词器"
        },
        {
          "id": "llm.s01.i03",
          "kind": "tech",
          "text": "用 3Blue1Brown 第 5–6 集复习注意力机制，补上 Zero to Hero 前几集里不熟的反向传播"
        },
        {
          "id": "llm.s01.i04",
          "kind": "prod",
          "text": "同一个任务（如会议纪要生成）分别跑 3 个主流模型，记录质量、首 token 延迟、单次成本"
        },
        {
          "id": "llm.s01.i05",
          "kind": "prod",
          "text": "读 Artificial Analysis 的价格/速度榜，搞清楚“输入价、输出价、缓存价”三者对产品成本的影响"
        },
        {
          "id": "llm.s01.i06",
          "kind": "prod",
          "text": "写一页《模型选型对比表》：场景、候选模型、选择理由、风险"
        }
      ],
      "resources": [
        {
          "id": "llm.s01.r01",
          "name": "Karpathy · Neural Networks: Zero to Hero",
          "url": "https://karpathy.ai/zero-to-hero.html"
        },
        {
          "id": "llm.s01.r02",
          "name": "Let's build GPT: from scratch（视频）",
          "url": "https://www.youtube.com/watch?v=kCc8FmEb1nY"
        },
        {
          "id": "llm.s01.r03",
