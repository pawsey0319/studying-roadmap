{
  "id": "llm",
  "domain": "ai",
  "name": "AI 大模型",
  "short": "大模型",
  "color": "#2557D6",
  "goal": "从“会用、懂 Transformer”走到能看懂训练/后训练/推理部署的关键取舍，并能把前沿进展翻译成产品判断。",
  "live": {
    "hf": "large language model reasoning",
    "hn": "LLM",
    "gh": "llm"
  },
  "stages": [
    {
      "id": "llm.s01",
      "title": "从 Transformer 到 GPT：亲手搭一遍",
      "goal": "把已知的 Transformer 架构变成能跑的代码，同时建立对 token、上下文、价格的产品直觉。",
      "items": [
        {
          "id": "llm.s01.i01",
          "kind": "tech",
          "text": "看完 Karpathy《Let's build GPT》并逐行复现，跑通 nanoGPT 的 Shakespeare 字符级模型",
          "mode": "practice"
        },
        {
          "id": "llm.s01.i02",
          "kind": "tech",
          "text": "看《Let's build the GPT Tokenizer》，手写一个最小 BPE 分词器",
          "mode": "practice"
        },
        {
          "id": "llm.s01.i03",
          "kind": "tech",
          "text": "用 3Blue1Brown 第 5–6 集复习注意力机制，补上 Zero to Hero 前几集里不熟的反向传播",
          "mode": "theory"
        },
        {
          "id": "llm.s01.i04",
          "kind": "prod",
          "text": "同一个任务（如会议纪要生成）分别跑 3 个主流模型，记录质量、首 token 延迟、单次成本",
          "mode": "practice"
        },
        {
          "id": "llm.s01.i05",
          "kind": "prod",
          "text": "读 Artificial Analysis 的价格/速度榜，搞清楚“输入价、输出价、缓存价”三者对产品成本的影响",
          "mode": "theory"
        },
        {
          "id": "llm.s01.i06",
          "kind": "prod",
          "text": "写一页《模型选型对比表》：场景、候选模型、选择理由、风险",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "llm.s01.r01",
          "name": "Karpathy · Neural Networks: Zero to Hero",
          "url": "https://karpathy.ai/zero-to-hero.html"
        },
        {
          "id": "llm.s01.r02",
          "name": "Let's build GPT: from scratch（视频）",
          "url": "https://www.youtube.com/watch?v=kCc8FmEb1nY"
        },
        {
          "id": "llm.s01.r03",
          "name": "nanoGPT",
          "url": "https://github.com/karpathy/nanoGPT"
        },
        {
          "id": "llm.s01.r04",
          "name": "3Blue1Brown 神经网络系列",
          "url": "https://www.3blue1brown.com/topics/neural-networks"
        },
        {
          "id": "llm.s01.r05",
          "name": "The Illustrated Transformer",
          "url": "https://jalammar.github.io/illustrated-transformer/"
        },
        {
          "id": "llm.s01.r06",
          "name": "Build a Large Language Model (From Scratch) 代码库",
          "url": "https://github.com/rasbt/LLMs-from-scratch"
        },
        {
          "id": "llm.s01.r07",
          "name": "Datawhale happy-llm（中文，从零理解大模型）",
          "url": "https://github.com/datawhalechina/happy-llm"
        },
        {
          "id": "llm.s01.r08",
          "name": "李宏毅 2025 机器学习课程（中文）",
          "url": "https://speech.ee.ntu.edu.tw/~hylee/ml/2025-spring.php"
        },
        {
          "id": "llm.s01.r09",
          "name": "Artificial Analysis 模型对比",
          "url": "https://artificialanalysis.ai/"
        }
      ],
      "output": "跑通的 nanoGPT 仓库 + 一页模型选型对比表"
    },
    {
      "id": "llm.s02",
      "title": "预训练、Scaling 与后训练",
      "goal": "理解一个模型从预训练到 SFT、RLHF、RL 推理训练的完整流水线，以及每一步在买什么能力。",
      "items": [
        {
          "id": "llm.s02.i01",
          "kind": "tech",
          "text": "精读 Scaling Laws 与 Chinchilla，能说清“参数量、数据量、算力”怎么配比",
          "mode": "theory"
        },
        {
          "id": "llm.s02.i02",
          "kind": "tech",
          "text": "精读 InstructGPT（RLHF）与 DPO，画出两者的流程差异",
          "mode": "theory"
        },
        {
          "id": "llm.s02.i03",
          "kind": "tech",
          "text": "精读 DeepSeekMath（GRPO）与 DeepSeek-R1，理解可验证奖励的强化学习为什么能训出推理能力",
          "mode": "theory"
        },
        {
          "id": "llm.s02.i04",
          "kind": "tech",
          "text": "读 nanochat 代码，跟着走一遍 预训练 → 中训练 → SFT → RL 的最小完整流程",
          "mode": "practice"
        },
        {
          "id": "llm.s02.i05",
          "kind": "prod",
          "text": "读 Test-Time Compute 论文，总结“让模型多想一会儿”对产品延迟、价格、交互设计的影响",
          "mode": "theory"
        },
        {
          "id": "llm.s02.i06",
          "kind": "prod",
          "text": "写一篇 800 字短文：推理模型出现后，哪些产品形态变了（如深度研究、后台长任务）",
          "mode": "practice"
        }
      ],
      "resources": [
        {
          "id": "llm.s02.r01",
          "name": "Scaling Laws for Neural Language Models",
          "url": "https://arxiv.org/abs/2001.08361"
        },
        {
          "id": "llm.s02.r02",
          "name": "Chinchilla: Training Compute-Optimal LLMs",
          "url": "https://arxiv.org/abs/2203.15556"
        },
        {
          "id": "llm.s02.r03",
          "name": "InstructGPT: Training LMs to follow instructions with human feedback",
          "url": "https://arxiv.org/abs/2203.02155"
        },
        {
          "id": "llm.s02.r04",
          "name": "DPO: Direct Preference Optimization",
          "url": "https://arxiv.org/abs/2305.18290"
        },
        {
          "id": "llm.s02.r05",
          "name": "DeepSeekMath（提出 GRPO）",
          "url": "https://arxiv.org/abs/2402.03300"
        },
        {
          "id": "llm.s02.r06",
