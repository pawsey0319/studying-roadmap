          "url": "https://arxiv.org/abs/2501.12948"
        },
        {
          "id": "llm.s02.r07",
          "name": "Scaling LLM Test-Time Compute",
          "url": "https://arxiv.org/abs/2408.03314"
        },
        {
          "id": "llm.s02.r08",
          "name": "HF 博客：Illustrating RLHF",
          "url": "https://huggingface.co/blog/rlhf"
        },
        {
          "id": "llm.s02.r09",
          "name": "nanochat（Karpathy 全流程最小实现）",
          "url": "https://github.com/karpathy/nanochat"
        },
        {
          "id": "llm.s02.r10",
          "name": "Stanford CS336: Language Modeling from Scratch",
          "url": "https://stanford-cs336.github.io/"
        },
        {
          "id": "llm.s02.r11",
          "name": "HF Smol Training Playbook",
          "url": "https://huggingface.co/spaces/HuggingFaceTB/smol-training-playbook"
        }
      ],
      "output": "一张“大模型训练流水线”图（每步：数据、目标、成本、产出能力）+ 推理模型短文"
    },
    {
      "id": "llm.s03",
      "title": "推理部署与成本：MoE、KV Cache、量化",
      "goal": "搞懂一次 API 调用背后的推理系统，能估算自部署 vs 调 API 的成本。",
      "items": [
        {
          "id": "llm.s03.i01",
          "kind": "tech",
          "text": "读 vLLM / PagedAttention 论文，理解 KV Cache、连续批处理为什么决定吞吐",
          "mode": "theory"
        },
        {
          "id": "llm.s03.i02",
          "kind": "tech",
          "text": "读 DeepSeek-V3 技术报告的 MoE 与 MLA 部分，理解“总参数 vs 激活参数”",
          "mode": "theory"
        },
        {
          "id": "llm.s03.i03",
          "kind": "tech",
          "text": "本地用 vLLM 或 Ollama 部署一个 7B 级开源模型，压测并记录 tokens/s",
          "mode": "practice"
        },
        {
          "id": "llm.s03.i04",
          "kind": "tech",
          "text": "浏览 Ultra-Scale Playbook，知道数据/张量/流水线并行各解决什么问题即可",
          "mode": "theory"
        },
        {
          "id": "llm.s03.i05",
          "kind": "prod",
          "text": "做一个成本模型表格：日活、每次对话 token 数、缓存命中率 → 月成本（API 与自部署两套）",
          "mode": "practice"
        },
        {
          "id": "llm.s03.i06",
          "kind": "prod",
          "text": "对比开源权重模型的许可证（MIT / Apache / 自定义），列出商用限制",
          "mode": "theory"
        }
      ],
      "resources": [
        {
          "id": "llm.s03.r01",
          "name": "vLLM",
          "url": "https://github.com/vllm-project/vllm"
        },
        {
          "id": "llm.s03.r02",
          "name": "PagedAttention 论文",
          "url": "https://arxiv.org/abs/2309.06180"
        },
        {
          "id": "llm.s03.r03",
          "name": "DeepSeek-V3 Technical Report",
          "url": "https://arxiv.org/abs/2412.19437"
        },
        {
          "id": "llm.s03.r04",
          "name": "GLM-4.5 技术报告（Agentic/Reasoning/Coding）",
