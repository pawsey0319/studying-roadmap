    {
      "id": "llm.s04",
      "title": "评估、RAG 与 AI 产品工程",
      "weeks": [
        15,
        20
      ],
      "goal": "把模型变成可靠的产品：会写评估、会做 RAG、会定义质量指标。",
      "items": [
        {
          "id": "llm.s04.i01",
          "kind": "tech",
          "text": "读 RAG 原始论文，用 LightRAG 或 RAGFlow 搭一个个人知识库问答"
        },
        {
          "id": "llm.s04.i02",
          "kind": "tech",
          "text": "用 promptfoo 给自己的 RAG 写 30 条评估用例，跑出准确率和失败分类"
        },
        {
          "id": "llm.s04.i03",
          "kind": "tech",
          "text": "学 Anthropic / OpenAI 官方提示工程文档，整理成自己的提示模板库"
        },
        {
          "id": "llm.s04.i04",
          "kind": "prod",
          "text": "精读 Hamel Husain 的评估文章，按“错误分析 → 指标 → 自动评估”给自己的产品设计评估方案"
        },
        {
          "id": "llm.s04.i05",
          "kind": "prod",
          "text": "读 Chip Huyen《AI Engineering》对应章节，总结 AI 产品与传统产品在 PRD 上的差异"
        },
        {
          "id": "llm.s04.i06",
          "kind": "prod",
          "text": "写一份带评估指标、上线门槛、失败兜底的 AI 功能 PRD"
        }
      ],
      "resources": [
