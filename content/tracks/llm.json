        },
        {
          "id": "llm.s01.r06",
          "name": "Build a Large Language Model (From Scratch) 代码库",
          "url": "https://github.com/rasbt/LLMs-from-scratch"
        },
        {
          "id": "llm.s01.r07",
          "name": "Datawhale happy-llm（中文，从零理解大模型）",
          "url": "https://github.com/datawhalechina/happy-llm"
        },
        {
          "id": "llm.s01.r08",
          "name": "李宏毅 2025 机器学习课程（中文）",
          "url": "https://speech.ee.ntu.edu.tw/~hylee/ml/2025-spring.php"
        },
        {
          "id": "llm.s01.r09",
          "name": "Artificial Analysis 模型对比",
          "url": "https://artificialanalysis.ai/"
        }
      ],
      "output": "跑通的 nanoGPT 仓库 + 一页模型选型对比表"
    },
    {
      "id": "llm.s02",
      "title": "预训练、Scaling 与后训练",
      "weeks": [
        5,
        9
      ],
      "goal": "理解一个模型从预训练到 SFT、RLHF、RL 推理训练的完整流水线，以及每一步在买什么能力。",
      "items": [
        {
          "id": "llm.s02.i01",
          "kind": "tech",
          "text": "精读 Scaling Laws 与 Chinchilla，能说清“参数量、数据量、算力”怎么配比"
        },
        {
          "id": "llm.s02.i02",
          "kind": "tech",
          "text": "精读 InstructGPT（RLHF）与 DPO，画出两者的流程差异"
        },
        {
          "id": "llm.s02.i03",
          "kind": "tech",
          "text": "精读 DeepSeekMath（GRPO）与 DeepSeek-R1，理解可验证奖励的强化学习为什么能训出推理能力"
        },
        {
          "id": "llm.s02.i04",
          "kind": "tech",
          "text": "读 nanochat 代码，跟着走一遍 预训练 → 中训练 → SFT → RL 的最小完整流程"
        },
        {
          "id": "llm.s02.i05",
          "kind": "prod",
          "text": "读 Test-Time Compute 论文，总结“让模型多想一会儿”对产品延迟、价格、交互设计的影响"
        },
        {
          "id": "llm.s02.i06",
          "kind": "prod",
          "text": "写一篇 800 字短文：推理模型出现后，哪些产品形态变了（如深度研究、后台长任务）"
        }
      ],
      "resources": [
        {
