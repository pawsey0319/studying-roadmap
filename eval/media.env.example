# 无凭据示例：不要提交真实 MEDIA_TOKEN；服务启动前用 secrets.token_urlsafe(32) 生成。
# MEDIA_TOKEN=<runtime-only random value, minimum 24 characters>
MEDIA_PORT=8790
MEDIA_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 下载后设置为本机绝对路径；不得设置远程 URL。
# MEDIA_ASR_PATH=/absolute/local/snapshot/whisper-small-mlx/revision
# MEDIA_AUDIO_PATH=/absolute/local/snapshot/Qwen2-Audio-7B-Instruct-4bit/revision
# 浏览器独立设置：
# asrBase=http://127.0.0.1:8790/v1
# asrModel=local-whisper
# asrKey=同一个runtime-only MEDIA_TOKEN（由父端preset注入，不写入仓库）
# audioBase=http://127.0.0.1:8790/v1
# audioModel=local-audio（仅真实模型验证后启用）
# audioKey=同上
